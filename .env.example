# Copy to .env and fill in.

# --- Model backend ---
# "gemini" (free tier, recommended), "openai", or "anthropic"
LLM_PROVIDER=gemini

# --- Google Gemini (free tier - aistudio.google.com/apikey, no card needed) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
IMAGE_SIZE=1024x1024
MAX_IMAGES=24

# --- Image generation provider chain (tried in this order, first configured
# + successful wins): OpenRouter -> OpenAI -> the active backend's own image
# model (Gemini's, if billed) -> Pollinations.ai (free, no key, last resort).
# OpenRouter is usually cheapest and best quality - openrouter.ai/settings/keys
OPENROUTER_API_KEY=
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image

# --- Tavily: real web search for research() (free - 1000 searches/month, no
# card, just email signup at tavily.com) ---
TAVILY_API_KEY=

# --- Notion: leads database sync (official API, no risk) ---
# notion.so/my-integrations -> new integration -> copy token. Then share your
# leads database with that integration and copy its id from the URL.
NOTION_API_KEY=
NOTION_DATABASE_ID=

# --- OpenAI (optional alternative backend; also usable for images only) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_IMAGE_MODEL=gpt-image-1
# --- GEO: extra answer engines (added incrementally) ---
# PERPLEXITY_API_KEY=      # Perplexity sonar API
# SERPAPI_KEY=             # Google AI Overviews via SerpAPI

# --- Claude API (optional alternative backend) ---
# Accepts a real key or a `claude setup-token` OAuth token (sk-ant-oat...) -
# note the OAuth token is scoped to the Claude Code CLI/apps, not third-party
# use, and may be rate-limited here.
ANTHROPIC_API_KEY=
MODEL=claude-opus-5

# --- LinkedIn: one-time app registration, then use the "Connect LinkedIn"
# button in the console (sign-in only - links your real name/email so
# outreach campaigns default to them as the sender; no posting, no
# automation of connection requests or messages) ---
# 1. linkedin.com/developers/apps -> Create app
# 2. Products tab -> add "Sign In with LinkedIn using OpenID Connect"
#    (self-serve, instant approval)
# 3. Auth tab -> Authorized redirect URLs -> add:
#      http://127.0.0.1:8000/api/linkedin/callback
#    (or {PUBLIC_BASE_URL}/api/linkedin/callback if this server is public)
# 4. copy the Client ID / Client Secret from the Auth tab below
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Publicly reachable URL for this server - only needed if it's deployed
# somewhere other than localhost (e.g. an ngrok/Cloudflare Tunnel URL).
PUBLIC_BASE_URL=

# --- Postgres (matches docker-compose.yml) ---
DATABASE_URL=postgresql://maai:maai@127.0.0.1:5432/maai

# --- Control plane ---
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
WORKER_POLL_SECONDS=2.0
OUTPUT_DIR=output
# The JARVIS console runs on :3737 (3000/3001 are often taken).
CORS_ORIGINS=http://localhost:3737,http://127.0.0.1:3737
