# Copy to .env and fill in.

# --- Model backend ---
# "gemini" (free tier, recommended), "openai", or "anthropic"
LLM_PROVIDER=gemini

# --- Google Gemini (free tier - aistudio.google.com/apikey, no card needed) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
IMAGE_SIZE=1024x1024
MAX_IMAGES=24

# --- Image generation provider chain (tried in this order, first configured
# + successful wins): OpenRouter -> OpenAI -> the active backend's own image
# model (Gemini's, if billed) -> Pollinations.ai (free, no key, last resort).
# OpenRouter is usually cheapest and best quality - openrouter.ai/settings/keys
OPENROUTER_API_KEY=
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image

# --- OpenAI (optional alternative backend; also usable for images only) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_IMAGE_MODEL=gpt-image-1
# --- GEO: extra answer engines (added incrementally) ---
# PERPLEXITY_API_KEY=      # Perplexity sonar API
# SERPAPI_KEY=             # Google AI Overviews via SerpAPI

# --- Claude API (optional alternative backend) ---
# Accepts a real key or a `claude setup-token` OAuth token (sk-ant-oat...) -
# note the OAuth token is scoped to the Claude Code CLI/apps, not third-party
# use, and may be rate-limited here.
ANTHROPIC_API_KEY=
MODEL=claude-opus-5

# --- Autonomous publish cycle ---
# How often (minutes) the worker runs a full scout->write->visualize->publish
# cycle on its own, round-robining youtube/instagram/linkedin. 0 disables it.
AUTO_CONTENT_MINUTES=60

# --- LinkedIn posting ---
# linkedin.com/developers/apps -> add "Share on LinkedIn" product -> OAuth
# consent for a w_member_social token.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=

# --- Instagram posting ---
# developers.facebook.com -> Instagram product -> link a Facebook Page to an
# Instagram Professional/Business account -> add it as an Instagram Tester.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# Publicly reachable URL for this server (Meta must fetch images over the
# internet) - e.g. an ngrok/Cloudflare Tunnel URL, or a real deployment.
PUBLIC_BASE_URL=

# --- Postgres (matches docker-compose.yml) ---
DATABASE_URL=postgresql://maai:maai@127.0.0.1:5432/maai

# --- Control plane ---
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
WORKER_POLL_SECONDS=2.0
OUTPUT_DIR=output
# The JARVIS console runs on :3737 (3000/3001 are often taken).
CORS_ORIGINS=http://localhost:3737,http://127.0.0.1:3737

# --- Studio (Agent 8): AI video -> YouTube ---
# comfy = local ComfyUI (free, unlimited) | openai = Sora (paid) | hf = Hugging Face Inference (free tier)
VIDEO_PROVIDER=comfy
COMFY_URL=http://127.0.0.1:8188
COMFY_WORKFLOW=studio/comfy_workflow.json
OPENAI_VIDEO_MODEL=sora-2
VIDEO_SIZE=1280x720
# free token: https://huggingface.co/settings/tokens
HF_TOKEN=
HF_VIDEO_MODEL=Wan-AI/Wan2.2-TI2V-5B
YT_PRIVACY=unlisted
# STUDIO_AUDIO=asmr_loop.mp3

# --- YouTube OAuth (shared by Studio's video uploads and the publisher) ---
# One-time desktop-app OAuth client from Google Cloud Console -> writes a
# local token file after `python studio_cli.py auth` (or the equivalent
# publisher flow) completes the browser consent once.
YOUTUBE_CLIENT_SECRETS=youtube_client_secret.json
YOUTUBE_TOKEN=youtube_token.json
# Alternative: a refresh token issued out-of-band, used by agent4_publisher
# if no local client-secret/token file pair is present.
YOUTUBE_CLIENT_SECRET_JSON=
YOUTUBE_REFRESH_TOKEN=
