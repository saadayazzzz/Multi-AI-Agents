# Copy to .env and fill in.

# --- Model backend ---
# "openai" or "anthropic"
LLM_PROVIDER=openai

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# --- GEO: extra answer engines (added incrementally) ---
# PERPLEXITY_API_KEY=      # Perplexity sonar API
# SERPAPI_KEY=             # Google AI Overviews via SerpAPI
# Agent 4 product images (OpenAI only). Falls back dall-e-3 -> dall-e-2.
OPENAI_IMAGE_MODEL=gpt-image-1
IMAGE_SIZE=1024x1024
MAX_IMAGES=24

# --- Claude API (used when LLM_PROVIDER=anthropic) ---
# Accepts a real key or a `claude setup-token` OAuth token (sk-ant-oat...).
ANTHROPIC_API_KEY=
MODEL=claude-opus-5

# --- Postgres (matches docker-compose.yml) ---
DATABASE_URL=postgresql://maai:maai@localhost:5432/maai

# --- Scraper politeness ---
SCRAPER_USER_AGENT=MultiAgentAI-Research/0.1 (+contact: you@example.com)
SCRAPE_DELAY_SECONDS=2.0
RESPECT_ROBOTS=true

# --- Pipeline sizing ---
MAX_SITES=8
MAX_PAGES_PER_SITE=12
OUTPUT_DIR=output

# --- Control plane ---
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
WORKER_POLL_SECONDS=2.0
# The JARVIS console runs on :3737 (3000/3001 are often taken).
CORS_ORIGINS=http://localhost:3737,http://127.0.0.1:3737
